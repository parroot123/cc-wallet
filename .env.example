# Optional — leave unset to run 100% local (no accounts, no sync).
# Copy this file to .env.local and fill in your own Supabase project's
# values (Project Settings → API in the Supabase dashboard). The anon key
# is a public, client-safe key by design — access is enforced by the RLS
# policies in supabase/migration.sql, not by keeping this key secret.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
